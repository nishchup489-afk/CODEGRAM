DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codegram
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Use Redis in multi-instance production deployments so rate limits are shared.
# Without REDIS_URL, limits are process-local and intended for development only.
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_SENSITIVE_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Clerk Frontend API URL; this is also the expected session-token issuer.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_replace_me
# Optional overrides:
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# CLERK_JWT_AUDIENCE=

ADMIN_CLERK_USER_IDS=

# Optional: raises GitHub API validation limits for repository URLs.
# GITHUB_TOKEN=github_pat_replace_me
